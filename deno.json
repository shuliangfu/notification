{
  "name": "@dreamer/notification",
  "version": "1.1.0",
  "license": "Apache-2.0",
  "exports": {
    ".": "./src/mod.ts",
    "./types": "./src/types.ts",
    "./utils": "./src/utils.ts",
    "./email": "./src/email.ts",
    "./webpush": "./src/webpush.ts",
    "./sms": "./src/sms.ts",
    "./webhook": "./src/webhook.ts",
    "./subscription": "./src/subscription.ts",
    "./template": "./src/template.ts",
    "./queue": "./src/queue.ts"
  },
  "imports": {
    "@dreamer/i18n": "jsr:@dreamer/i18n@^1.1.2",
    "@dreamer/runtime-adapter": "jsr:@dreamer/runtime-adapter@^1.2.2",
    "@dreamer/email": "jsr:@dreamer/email@^1.1.0",
    "@dreamer/test": "jsr:@dreamer/test@^1.2.3"
  },
  "tasks": {
    "test": "deno test -A tests/",
    "check": "deno check src/mod.ts",
    "lint": "deno lint src/ tests/",
    "fmt": "deno fmt src/ tests/"
  },
  "publish": {
    "include": [
      "src/**/*.ts",
      "src/**/*.json",
      "deno.json",
      "README.md",
      "LICENSE",
      "NOTICE"
    ],
    "exclude": [
      "tests/**",
      "**/*.test.ts"
    ]
  },
  "nodeModulesDir": "auto",
  "minimumDependencyAge": 0,
  "compilerOptions": {
    "strict": true,
    "lib": [
      "esnext",
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "deno.ns",
      "deno.window"
    ]
  }
}
