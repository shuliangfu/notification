{
  "name": "@dreamer/notification",
  "version": "1.1.0",
  "description": "Notification utilities (email, webpush, sms, webhook) for Deno/Bun/Node.",
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": "./src/mod.ts",
    "./types": "./src/types.ts",
    "./utils": "./src/utils.ts",
    "./email": "./src/email.ts",
    "./webpush": "./src/webpush.ts",
    "./sms": "./src/sms.ts",
    "./webhook": "./src/webhook.ts",
    "./subscription": "./src/subscription.ts",
    "./template": "./src/template.ts",
    "./queue": "./src/queue.ts"
  },
  "scripts": {
    "test": "bun test tests/",
    "test:node": "tsx --tsconfig tsconfig.json --test --test-force-exit tests/*.test.ts",
    "check": "deno check src/mod.ts",
    "lint": "deno lint src/ tests/",
    "fmt": "deno fmt src/ tests/"
  },
  "dependencies": {
    "@dreamer/email": "npm:@jsr/dreamer__email@^1.1.0",
    "@dreamer/i18n": "npm:@jsr/dreamer__i18n@^1.1.2",
    "@dreamer/runtime-adapter": "npm:@jsr/dreamer__runtime-adapter@^1.2.2"
  },
  "devDependencies": {
    "@dreamer/test": "npm:@jsr/dreamer__test@^1.2.3",
    "tsx": "^4.23.1"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.3"
  },
  "keywords": ["notification", "email", "webpush", "sms", "webhook", "dreamer"]
}
